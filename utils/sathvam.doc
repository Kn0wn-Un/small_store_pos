<!-- GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

  <!-- RAZORPAY -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <!-- SHADCN STYLE EFFECTS -->
  <style>

    .shadcn-card {
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.4);
    }

    .shine-btn {
      position: relative;
      overflow: hidden;
    }

    .shine-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        120deg,
        transparent,
        rgba(255,255,255,0.3),
        transparent
      );
      transition: all .8s ease;
    }

    .shine-btn:hover::before {
      left: 120%;
    }

    .hover-glow:hover {
      box-shadow:
      0 10px 35px rgba(44,62,87,0.15),
      0 10px 20px rgba(182,146,36,0.18);
    }

  </style>

  <script>

    // GSAP ANIMATIONS

    gsap.from("header", {
      y: -80,
      opacity: 0,
      duration: 1
    });

    gsap.from("h1", {
      x: -80,
      opacity: 0,
      duration: 1.2
    });

    gsap.from(".hero-shape", {
      scale: .8,
      opacity: 0,
      duration: 1.4
    });

    gsap.from(".card-hover", {
      y: 50,
      opacity: 0,
      stagger: 0.2,
      duration: 1
    });


    // FLOATING PARTICLES

    function createParticle() {

      const particle = document.createElement('div');

      particle.classList.add('particle');

      particle.style.position = 'fixed';
      particle.style.width = Math.random() * 8 + 'px';
      particle.style.height = particle.style.width;
      particle.style.background = 'rgba(182,146,36,0.15)';
      particle.style.borderRadius = '50%';
      particle.style.left = Math.random() * window.innerWidth + 'px';
      particle.style.top = window.innerHeight + 'px';
      particle.style.pointerEvents = 'none';
      particle.style.zIndex = '0';

      document.body.appendChild(particle);

      gsap.to(particle, {
        y: -window.innerHeight - 200,
        x: Math.random() * 200 - 100,
        opacity: 0,
        duration: Math.random() * 10 + 8,
        ease: 'none',
        onComplete: () => particle.remove()
      });
    }

    setInterval(createParticle, 800);


    // RAZORPAY PAYMENT

    function payNow(productName, amount) {

      const options = {

        key: 'YOUR_RAZORPAY_KEY',

        amount: amount * 100,

        currency: 'INR',

        name: 'SATHVAM',

        description: productName,

        image: 'https://your-logo-url.com/logo.png',

        handler: function(response) {

          alert(
            'Payment Successful! Payment ID: ' +
            response.razorpay_payment_id
          );
        },

        theme: {
          color: '#2C3E57'
        }
      };

      const rzp = new Razorpay(options);

      rzp.open();
    }


    // BUTTON CONNECT

    document.querySelectorAll('.buy-btn').forEach(btn => {

      btn.addEventListener('click', () => {

        const product = btn.dataset.product;

        const amount = btn.dataset.amount;

        payNow(product, amount);
      });
    });

  </script>

<script>

  gsap.from("header", {
    y: -80,
    opacity: 0,
    duration: 1
  });

  gsap.from("h1", {
    x: -100,
    opacity: 0,
    duration: 1.2
  });

  gsap.from(".hero-shape", {
    scale: 0.8,
    opacity: 0,
    duration: 1.5
  });

  gsap.from(".grid > div", {
    opacity: 0,
    y: 40,
    stagger: 0.15,
    duration: 1
  });

</script>


